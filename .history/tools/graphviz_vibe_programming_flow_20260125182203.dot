digraph VibeProgrammingFlow {
    // 图表设置
    graph [
        rankdir=TB
        bgcolor=white
        fontname="Arial,Microsoft YaHei,SimHei"
        fontsize=14
        splines=ortho
        nodesep=0.8
        ranksep=1.0
    ]
    
    node [
        shape=box
        style="rounded,filled"
        fontname="Arial,Microsoft YaHei,SimHei"
        fontsize=13
        margin=0.3
        width=3.5
        height=0.8
    ]
    
    edge [
        fontname="Arial,Microsoft YaHei,SimHei"
        fontsize=11
        labelfloat=true
        labeldistance=2.0
    ]
    
    // 标题
    Title [
        label="Vibe Programming 工作流程"
        shape=plaintext
        fontsize=20
        fontcolor=black
    ]
    
    // 主流程节点
    Start [
        label="1. 人：给出模糊提示词\n\"做一个用户管理页面\""
        fillcolor="#FFE5B4"
        color=black
    ]
    
    AI [
        label="2. AI：直接生成实现\n• 组件结构\n• 数据模型\n• 交互逻辑"
        fillcolor="#B4D7FF"
        color=black
    ]
    
    Code [
        label="3. 可运行的代码"
        fillcolor="#E5E5E5"
        color=black
        fontsize=15
    ]
    
    Test [
        label="4. 人：测试和反馈"
        fillcolor="#FFE4E4"
        color=black
        fontsize=15
    ]
    
    // 分支节点
    Error [
        label="情况1: 运行错误\n\"编译失败\"、\"依赖缺失\""
        fillcolor="#FFE4E4"
        color=red
        penwidth=2
    ]
    
    Feature [
        label="情况2: 功能不符\n\"需要action buttons\"\n\"添加表单验证\""
        fillcolor="#FFF8E4"
        color=orange
        penwidth=2
    ]
    
    Success [
        label="情况3: 达到预期 ✓\n功能完成！"
        fillcolor="#E4FFE4"
        color=green
        penwidth=2
        fontsize=14
    ]
    
    Next [
        label="进入下一个 Feature"
        fillcolor="#C8FFC8"
        color=green
        penwidth=2
        fontsize=15
    ]
    
    // 图例
    Legend [
        shape=plaintext
        label=<
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8">
                <TR><TD BGCOLOR="#FFE5B4">人的活动</TD></TR>
                <TR><TD BGCOLOR="#B4D7FF">AI的活动</TD></TR>
                <TR><TD BGCOLOR="#E5E5E5">代码状态</TD></TR>
                <TR><TD BGCOLOR="#FFE4E4">决策点</TD></TR>
            </TABLE>
        >
    ]
    
    Note [
        label="💡 核心：快速迭代，边做边调整"
        shape=box
        style="rounded,filled"
        fillcolor="#FFFACD"
        color=orange
        fontsize=14
    ]
    
    // 主流程
    Title -> Start [style=invis]
    Start -> AI [label="context:\n语言、风格" fontsize=10]
    AI -> Code
    Code -> Test
    
    // 分支流程
    Test -> Error [label="粘贴错误信息" color=red fontcolor=red]
    Test -> Feature [label="提出改进要求" color=orange fontcolor=orange]
    Test -> Success [color=green]
    
    // 反馈循环
    Error -> AI [label="修复" color=red style=dashed]
    Feature -> AI [label="改进" color=orange style=dashed]
    Success -> Next [color=green penwidth=2]
    
    // 布局辅助
    {rank=same; Error; Feature; Success}
    {rank=min; Title}
    {rank=max; Legend; Note}
}
